<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark theme's half of D-05f (see res/values-v27/themes.xml) on API 27 and up: light
      navigation buttons over the platform's dark scrim, where the light grey scrim and its dark
      buttons used to show (15e O-1), and the light status-bar icons res/values-night/themes.xml
      asks for. The same style and parent, restated whole, because styles do not merge across
      qualifiers: on API 27 and up this style replaces res/values-night/themes.xml's for the window.
    -->
    <style name="Theme.PegSolitaire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
