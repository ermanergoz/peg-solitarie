<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window theme on API 27 and up (D-05f, ux-spec §6.2; tech-lead-signoff-close.md INFO
      row 9). Edge to edge, the system bars have no colour of the app's own; the window decides only
      their appearance. As res/values/themes.xml does for the status bar (F-2), this asks for the
      navigation bar's dark buttons, over the platform's light scrim, in the light theme. The theme
      sets it rather than Compose, so it holds from the window's first frame, before any composition.

      The navigation attribute is API 27 and minSdk is 24, so it lives only here and in
      res/values-night-v27/; res/values/ and res/values-night/ stay the API 24-26 styles, where the
      platform's navigation bar is left as it is. And this file restates the WHOLE style, the
      status-bar item included, because styles do not merge across qualifiers: on API 27 and up
      this style replaces res/values/themes.xml's for the window. WindowThemeTest resolves both items.
    -->
    <style name="Theme.PegSolitaire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
