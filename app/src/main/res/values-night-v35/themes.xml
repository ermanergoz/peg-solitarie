<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark theme's half of the API 35 window theme (D-05f; tech-lead defect ruling §1, B-1):
      light navigation buttons over the platform's dark scrim, where a forced light grey scrim with
      dark buttons used to show, and the light status-bar icons res/values-night/themes.xml asks
      for. The bar's colour is named transparent for the reason res/values-v35/themes.xml gives: the
      platform honours windowLightNavigationBar only while the theme names a navigation-bar colour,
      and without one it forces the light bar back. Do not remove that item as unused or
      deprecated. The same style and parent, restated whole, because styles do not merge across
      qualifiers.
    -->
    <style name="Theme.PegSolitaire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
