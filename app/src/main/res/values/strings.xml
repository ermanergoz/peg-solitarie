    <string name="tutorial_step_1_caption">Tap a peg, then tap the empty hole two cells away.</string>
    <!-- T2 teaches the other axis, and that diagonals are never offered. -->
    <string name="tutorial_step_2_caption">Jumps work up, down, left and right — never diagonally.</string>
    <!-- T3 teaches the goal. -->
    <string name="tutorial_step_3_caption">Keep jumping. Clear the board down to one peg.</string>
    <!-- Shown with the completion star and the CTA, once T3 is cleared. -->
    <string name="tutorial_done_caption">That\'s the whole game. Go clear a board.</string>

