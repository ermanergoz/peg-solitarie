<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-facing copy (CLAUDE.md no-magic-strings rule). Wording is the verbatim
  Copywriting Contract from the Phase-1 UI-SPEC. The pegs-remaining count is a
  plural-aware resource so "1 peg" / "n pegs" agree grammatically.

  The game-over and restart-confirm strings are consumed by the dialogs in
  Plan 05; they are declared here so the copy contract lives in one place.
-->
<resources>
    <string name="app_name">Peg Solitaire</string>

    <!-- Top-bar restart control (icon-only; this is its content description). -->
    <string name="restart_board">Restart Board</string>

    <!-- Game-over dialog (D-05). -->
    <string name="play_again">Play Again</string>
    <string name="view_board">View Board</string>
    <string name="game_over_perfect_headline">Perfect!</string>
    <string name="game_over_perfect_body">You cleared the board down to a single peg.</string>
    <string name="game_over_near_headline">So close!</string>
    <string name="game_over_stuck_headline">No moves left</string>

    <!-- Mid-game restart confirmation (D-06). -->
    <string name="restart_confirm_title">Restart this board?</string>
    <string name="restart_confirm_body">Your current progress will be lost.</string>
    <string name="keep_playing">Keep Playing</string>

    <!-- Pegs-remaining body copy, plural-aware ({n}). -->
    <plurals name="pegs_remaining">
        <item quantity="one">%d peg remaining.</item>
        <item quantity="other">%d pegs remaining.</item>
    </plurals>
    <plurals name="pegs_remaining_retry">
        <item quantity="one">%d peg remaining. Try again?</item>
        <item quantity="other">%d pegs remaining. Try again?</item>
    </plurals>

    <!--
      ============================ Phase-2 copy ============================
      All Phase-2 user-facing strings, declared here up front so the Classic-flow
      UI plans (Catalog 02-05, Home/onboarding 02-06, Results 02-07) read them via
      stringResource(...) with no magic strings. Verbatim from the Phase-2 UI-SPEC
      Copywriting Contract. Phase-1 strings above are reused, not duplicated
      (e.g. restart_board for the gameplay restart content description).
    -->

    <!-- Classic board display names (catalog cards, ascending hole count). -->
    <string name="board_english33">English-33</string>
    <string name="board_european37">European-37</string>
    <string name="board_asymmetric39">Asymmetric 3-3-2-2</string>
    <string name="board_diamond41">Diamond-41</string>
    <string name="board_wiegleb45">Wiegleb-45</string>

    <!-- Home (mode select). -->
    <string name="classic_tile_title">Classic</string>
    <string name="classic_tile_supporting">5 boards</string>
    <string name="challenge_tile_title">Challenge</string>
    <!-- The Challenge tile's supporting line: the player's persisted ladder position (CHAL-05). -->
    <string name="challenge_tile_continue">Continue — Level %1$d</string>
    <string name="coming_soon">Coming soon</string>
    <string name="how_to_play">How to play</string>

    <!-- Classic catalog. -->
    <string name="catalog_title">Classic</string>
    <!-- Hole-count subtitle on each catalog card, plural-aware. -->
    <plurals name="holes_count">
        <item quantity="one">%d hole</item>
        <item quantity="other">%d holes</item>
    </plurals>
    <!--
      Screen-reader description of a catalog card's earned-star pips (PERS-01, D-10):
      the row announces its count once ("1 of 3 stars") instead of three anonymous icons.
    -->
    <string name="catalog_stars_earned">%1$d of %2$d stars</string>

    <!-- Gameplay top bar (timer + back; restart_board reused from Phase 1). -->
    <string name="navigate_back">Navigate back</string>
    <string name="elapsed_time">Elapsed time</string>
    <!-- Challenge gameplay top-bar "Level N" title + its screen-reader description (S2, D-03). -->
    <string name="challenge_level_indicator">Level %1$d</string>
    <string name="challenge_level_indicator_desc">Challenge level %1$d</string>
    <!-- Undo control (icon-only; disabled when there is nothing to undo, ASST-02). -->
    <string name="undo_action">Undo</string>
    <!-- Winning-move Hint action (icon-only; distinct from the show-moves toggle, D-01/D-02). -->
    <string name="hint_action">Hint</string>
    <!-- Announced while the Solver computes a hint; the control is disabled (D-10). -->
    <string name="hint_thinking">Finding a move</string>
    <!-- Show-possible-moves toggle (icon-only; content description reflects the on/off state, D-02). -->
    <string name="show_moves_on">Show possible moves</string>
    <string name="show_moves_off">Hide possible moves</string>
    <!-- Shown while a Challenge board is generated off the main thread (CR-01). -->
    <string name="loading_level">Loading level</string>

    <!--
      Inline no-win / stuck rescue banner (ASST-03, D-06/D-08/D-09). One shared banner
      surfaces either message over the still-interactive board; rescue_restart is the
      label form of the Restart action (distinct from the restart_board content-desc),
      and the banner reuses undo_action + action_home for its other two actions.
    -->
    <string name="nowin_message">No winning move — undo or restart</string>
    <string name="stuck_message">No moves left — undo or restart</string>
    <string name="rescue_restart">Restart</string>

    <!-- Results. -->
    <string name="results_title">Results</string>
    <string name="results_headline_perfect">Perfect!</string>
    <string name="results_headline_solved">Solved!</string>
    <string name="results_headline_stuck">Out of moves</string>
    <string name="results_label_score">SCORE</string>
    <string name="results_label_time">TIME</string>
    <string name="results_label_pegs_left">PEGS LEFT</string>
    <string name="action_replay">Replay</string>
    <string name="action_catalog">Catalog</string>
    <string name="action_home">Home</string>
    <!--
      Results "New best!" cue (PERS-01, D-09): shown only when the play actually improved
      one of the level's stored bests (stars, time or score).
    -->
    <string name="results_new_best">New best!</string>
    <!--
      Content description of the INT-04 quiescence scrim (AdQuiescenceScrim). Deliberately
      one neutral word: D-08 forbids drawn text or a spinner, but the dim still swallows
      every tap, so a screen reader must be told the screen is busy rather than be left
      announcing controls that no longer respond.
    -->
    <string name="results_ad_scrim_description">Preparing</string>
    <!-- Challenge-aware Results actions (S3, D-01/D-10). -->
    <string name="action_next_level">Next level</string>
    <string name="action_retry">Retry</string>
    <string name="challenge_load_error">Couldn\'t load this level. Tap Retry.</string>

    <!--
      ============================ Phase-5 copy ============================
      Settings (SET-01/SET-02, D-14..D-17). The sound supporting line states the
      honest Phase-5 truth — the choice is saved now and consumed when the audio
      pass lands (D-16) — while haptics describes the feedback that fires today
      (D-15). settings_action is the Home gear's content description.
    -->
    <string name="settings_title">Settings</string>
    <string name="settings_action">Settings</string>
    <string name="settings_sound_label">Sound</string>
    <string name="settings_sound_supporting">Saved for the upcoming sound effects</string>
    <string name="settings_haptics_label">Haptics</string>
    <string name="settings_haptics_supporting">Vibrate lightly on each jump</string>

    <!--
      Home "Continue" affordances for a saved in-progress game (PERS-03, D-01/D-03). Each
      mode has its own tile and they can appear together, so the titles name the mode
      rather than relying on position. The supporting lines say what is actually being
      resumed — the exact board, not a fresh start.
    -->
    <string name="resume_classic_title">Continue Classic</string>
    <string name="resume_classic_supporting">Pick up your saved board</string>
    <string name="resume_challenge_title">Continue Challenge</string>
    <string name="resume_challenge_supporting">Pick up Level %1$d where you left off</string>

    <!-- Onboarding overlay (first-run how-to-play of the orthogonal jump). -->
    <string name="onboarding_got_it">Got it</string>
    <string name="onboarding_skip">Skip tutorial</string>
    <string name="onboarding_step_1">Tap a peg, then tap an empty hole two cells away.</string>
    <string name="onboarding_step_2">The peg jumps straight over its neighbor — only up, down, left, or right.</string>
    <string name="onboarding_step_3">The jumped peg is removed. Clear the board down to one peg.</string>

    <!--
      ============================ Phase-9 copy ============================
      Consent & rewarded ads. Verbatim from the Phase-9 UI-SPEC Copywriting Contract.
      Declared here up front so the downstream plans (dialog 09-03, Settings 09-07,
      GameScreen funnel 09-08) read them via stringResource(...) and no plan but this
      one touches a resource file.
    -->

    <!--
      ADS-01 — rewarded opt-in dialog (D-06/D-07/D-10). The dialog is the ONLY signal the
      free-allowance system exists, so the body carries count, scope and reward in one
      breath: the title states the fact, the body proposes the trade.

      The allowance counts are format placeholders ONLY — never type a literal count into
      these strings. They are supplied at the callsite from AssistAllowanceLimits.FREE_HINTS
      / FREE_UNDOS, which is why D-02's numbers are named exactly once in the whole codebase
      and the copy cannot drift from the policy that grants it.
    -->
    <string name="ad_offer_watch">Watch ad</string>
    <string name="ad_offer_decline">No thanks</string>
    <string name="ad_offer_hint_title">Out of free hints</string>
    <string name="ad_offer_undo_title">Out of free undos</string>
    <string name="ad_offer_hint_body">You\'ve used your %1$d free hints for this level. Watch a short ad for %1$d more?</string>
    <string name="ad_offer_undo_body">You\'ve used your %1$d free undos for this level. Watch a short ad for %1$d more?</string>
    <!-- Spinner content description during the bounded wait; no visible label (D-10). -->
    <string name="ad_offer_loading">Loading ad</string>

    <!--
      ADS-03 — ad-unavailable snackbar (D-11). The assist lands FIRST, then the message
      states the problem and its already-applied resolution; no action is offered because
      none is needed. The em dash follows the shipped nowin_message
      ("No winning move — undo or restart") "problem — resolution" shape.
    -->
    <string name="ad_unavailable_hints">Ad unavailable — hints refilled for free</string>
    <string name="ad_unavailable_undos">Ad unavailable — undos refilled for free</string>

    <!--
      CONS-03 / REL-05 — Settings Privacy section (D-14/D-15). Both section headers are
      declared: a label over one group and not the other is exactly the inconsistency the
      UI contract exists to prevent. The policy-row failure copy follows the shipped
      challenge_load_error shape — a tap that does nothing would be a dead end.
    -->
    <string name="settings_section_general">General</string>
    <string name="settings_section_privacy">Privacy</string>
    <string name="settings_privacy_policy_label">Privacy policy</string>
    <string name="settings_privacy_policy_supporting">Opens in your browser</string>
    <string name="settings_privacy_policy_error">Couldn\'t open the privacy policy — no browser app found.</string>
    <string name="settings_privacy_choices_label">Manage privacy choices</string>
    <string name="settings_privacy_choices_supporting">Change your ad consent choices</string>

    <!--
      ============================ Phase-11 copy ============================
      Play Games opt-in (PGS-01, D-15/D-16). The title asks rather than announces: this
      is a genuine choice, not a step to get through. The body names the same three
      benefits as the Settings row (leaderboards, achievements, cloud save) and then says
      outright that the game is fully playable without signing in — D-16 requires both,
      because a prompt that only lists upside reads as a wall. The closing sentence names
      Settings, which is the ONLY way back in once this is answered (D-17/D-19).

      "Not now" rather than "No thanks": the answer is permanent for the prompt, but the
      door is not shut, and the copy should not claim otherwise.
    -->
    <string name="play_games_prompt_title">Sign in to Play Games?</string>
    <string name="play_games_prompt_body">Compete on leaderboards, unlock achievements, and keep your progress backed up to the cloud. Peg Solitaire plays exactly the same either way — you can sign in later from Settings.</string>
    <string name="play_games_prompt_accept">Sign in</string>
    <string name="play_games_prompt_decline">Not now</string>

    <!--
      D-10 / D-18 — the ONE sign-in failure message, shared verbatim by the Home prompt's
      accept path and the Settings sign-in row. Two strings here would be two wordings the
      moment either is edited, for what is the same event seen from two places.

      Raised ONLY when the SDK reports a genuine error. A player who simply dismissed the
      account chooser sees nothing at all — apologising for their own choice is what makes
      an optional feature feel like a failed mandatory one. Follows the shipped
      settings_privacy_policy_error shape; no action label, because the opt-in already
      stands and the next launch retries silently.
    -->
    <string name="play_games_signin_error">Couldn\'t sign in to Play Games</string>

    <!--
      D-08/D-09 — the Settings "Play Games" section, between General and Privacy.

      The row label and its supporting line are fixed verbatim by D-09 and must not be
      reworded: they are the one place a player who declined (or was never asked) reads
      what signing in actually buys them, and the three benefits named here are the same
      three the opt-in prompt above names. A second, prettier wording here would quietly
      make the two surfaces promise different things.

      The signed-in row is a statement, not an offer, so it is not phrased as an action.
      settings_play_games_signed_in_as carries the player's own Play Games display name;
      settings_play_games_signed_in_fallback replaces it whole when that lookup failed or
      stalled (D-14) — deliberately NOT "Signed in as (unknown)", which reads as a broken
      sign-in rather than the successful one it is.

      Phase 12 D-14/D-15 — the two stock-UI rows below the signed-in row, and they are
      shown to a signed-in player ONLY. Signed out, they are absent rather than disabled:
      a greyed-out "Leaderboards" is an affordance that explains nothing, whereas the
      sign-in row directly above it already says what to do. While the session is still
      Unknown the whole section is absent (Phase 11 D-11), these rows included.

      Both labels are fixed verbatim by D-14. "Leaderboards" is plural because the row
      opens the all-leaderboards picker, not one board — the supporting lines describe
      looking at what is already there, since neither row submits anything. No id and no
      player-identifying text belongs in either: the seam takes no argument for these.
    -->
    <string name="settings_section_play_games">Play Games</string>
    <string name="settings_play_games_signin_label">Sign in to Play Games</string>
    <string name="settings_play_games_signin_supporting">Leaderboards, achievements and cloud save</string>
    <string name="settings_play_games_signed_in_as">Signed in as %1$s</string>
    <string name="settings_play_games_signed_in_fallback">Signed in to Play Games</string>
    <string name="settings_play_games_leaderboards_label">Leaderboards</string>
    <string name="settings_play_games_leaderboards_supporting">See how your scores rank</string>
    <string name="settings_play_games_achievements_label">Achievements</string>
    <string name="settings_play_games_achievements_supporting">View the achievements you\'ve earned</string>
</resources>
