<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon, API 26+. The launcher supplies the mask (circle, squircle,
  rounded square, teardrop) and animates the two layers independently, so the background
  is full-bleed and the board sits inside the 66dp safe zone.

  <monochrome> is the API 33+ themed-icon layer. compileSdk 36 compiles the tag, and API
  26-32 simply ignores the unrecognised child, so it ships unconditionally.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
